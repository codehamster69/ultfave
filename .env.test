# End-to-end test environment. Mirrors tests/e2e/env.ts.
#
# Playwright injects these values directly into the web server command and into
# the migrate/seed child processes, so this file is documentation plus a manual
# escape hatch:
#
#   node --env-file=.env.test scripts/migrate.mjs
#   node --env-file=.env.test scripts/seed.mjs
#
# It is NOT `.env.local`: the suite must never read or write the developer's
# local.db.

# Throwaway libSQL database used by the suite (deleted and reseeded per run).
TURSO_DATABASE_URL=file:test.db
TURSO_AUTH_TOKEN=

# Fixed test-only session key (64 hex chars). Never reuse this in production.
SESSION_SECRET=e2e1c0de5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d

# Bearer secret the cron auth test sends to /api/cron/sync.
CRON_SECRET=e2e-cron-secret-0123456789abcdef

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Spotify stays off so the login flow is exercised without OAuth.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
